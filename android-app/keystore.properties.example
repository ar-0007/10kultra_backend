# Copy to `keystore.properties` (same folder) and fill in. That file is gitignored, and so is the
# .jks itself — both live only on the release machine and in your own backup.
#
# storeFile is resolved relative to android-app/.
storeFile=tenkultra-release.jks
storePassword=
keyAlias=tenkultra
keyPassword=

# On CI, skip this file and set instead:
#   TENKULTRA_STORE_FILE  TENKULTRA_STORE_PASSWORD  TENKULTRA_KEY_ALIAS  TENKULTRA_KEY_PASSWORD
